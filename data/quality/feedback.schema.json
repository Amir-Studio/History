{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "History Reviewed Correction",
  "type": "object",
  "required": [
    "id",
    "record_id",
    "issue_type",
    "original_output",
    "corrected_output",
    "reason",
    "reviewed_at",
    "reviewer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "record_id": {
      "type": "string"
    },
    "issue_type": {
      "enum": [
        "wrong_fact",
        "missing_context",
        "source_bias",
        "source_dependency",
        "bad_translation",
        "date_error",
        "unsupported_claim",
        "overconfidence",
        "other"
      ]
    },
    "original_output": {
      "type": "string"
    },
    "corrected_output": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 10
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "string",
      "minLength": 2
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}