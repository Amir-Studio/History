{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amir-studio.github.io/History/data/news/schema.json",
  "title": "History News Record",
  "type": "object",
  "required": [
    "id",
    "headline",
    "publisher",
    "source_url",
    "published_at",
    "collected_at",
    "summary",
    "claims",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "headline": {
      "type": "string",
      "minLength": 8
    },
    "publisher": {
      "type": "string",
      "minLength": 2
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "language": {
      "type": "string"
    },
    "category": {
      "enum": [
        "iran",
        "world",
        "economy",
        "technology",
        "people",
        "other"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 30
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidence_grade",
          "supporting_sources"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "evidence_grade": {
            "enum": [
              "A",
              "B",
              "C",
              "unverified"
            ]
          },
          "supporting_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "pending_review",
        "verified",
        "rejected",
        "archived"
      ]
    },
    "correction_note": {
      "type": "string"
    },
    "significance_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Editorial archive value only; not a probability of factual accuracy."
    },
    "significance_reason": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "publisher",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_type": {
            "enum": [
              "primary",
              "independent_reporting",
              "analysis",
              "other"
            ]
          },
          "original_reporting": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "ownership_or_mandate_note": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "claim_supported": {
            "type": "string"
          },
          "reporting_chain": {
            "type": "string"
          }
        }
      }
    },
    "independent_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "string"
          },
          "version_a": {
            "type": "string"
          },
          "version_b": {
            "type": "string"
          },
          "what_is_known": {
            "type": "string"
          },
          "what_remains_uncertain": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correction_watch": {
      "type": "string"
    },
    "review_note": {
      "type": "string"
    }
  }
}
